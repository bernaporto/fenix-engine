{
  "name": "@fenix-engine/ui",
  "version": "0.27.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "pnpm run build:styles",
    "build:styles": "sass --no-source-map --style compressed styles/index.scss styles.css",
    "dev:styles": "sass --no-source-map --style expanded --watch styles/index.scss styles.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fenix-engine/core": "workspace:*",
    "@fenix-engine/utilities": "workspace:*"
  },
  "devDependencies": {
    "sass": "^1.64.2",
    "typescript": "^5.0.2"
  }
}
